# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# LinkedIn Session Storage Encryption Key (Dedicated secret)
# Strict requirement in production: minimum 32 characters.
# Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=replace-with-a-secure-32-plus-character-secret-key-for-session-encryption

# Application Settings
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://localhost:5173"]
